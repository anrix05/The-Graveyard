# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key # Keep secret! Server-side only.

# Razorpay Configuration (Test Mode)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret # Keep secret! Server-side only.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret # For webhook HMAC validation

# GitHub API Configuration
GITHUB_ACCESS_TOKEN=ghp_your_personal_access_token # Scoped token for repo collaborator invites

# Cron & System Maintenance
CRON_SECRET=your-secret-cron-token # Secret header for Vercel Cron

# Demo Mode Settings
NEXT_PUBLIC_DEMO_MODE=true
DEMO_BUYER_EMAIL=buyer@graveyard.dev
DEMO_BUYER_PASSWORD=DemoPass123!@#
DEMO_SELLER_EMAIL=seller@graveyard.dev
DEMO_SELLER_PASSWORD=DemoPass123!@#
